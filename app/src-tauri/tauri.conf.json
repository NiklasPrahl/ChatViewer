{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatViewer",
  "version": "0.1.0",
  "identifier": "app.chatviewer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChatViewer",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "incognito": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' cvblob: http://cvblob.localhost data:; media-src 'self' cvblob: http://cvblob.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
